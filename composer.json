{
  "name": "sytxlabs/laravel-filesanitizer",
  "description": "Laravel integration for sytxlabs/filesanitizer",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
    "illuminate/validation": "^10.0|^11.0|^12.0|^13.0",
    "sytxlabs/filesanitizer": "*"
  },
  "require-dev": {
    "portavice/laravel-pint-config": "^2.0|^3.0",
    "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.0|^11.0|^12.0|^13.0"
  },
  "authors": [
    {
      "name": "Shaun Lüdeke",
      "email": "info@sytxlabs.eu",
      "homepage": "https://sytxlabs.eu",
      "role": "Developer"
    }
  ],
  "support": {
    "issues": "https://github.com/sytxlabs/laravel-filesanitizer/issues"
  },
  "autoload": {
    "psr-4": {
      "SytxLabs\\LaravelFileSanitizer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SytxLabs\\LaravelFileSanitizer\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SytxLabs\\LaravelFileSanitizer\\FileSanitizerServiceProvider"
      ],
      "aliases": {
        "FileSanitizer": "SytxLabs\\LaravelFileSanitizer\\Facades\\FileSanitizer"
      }
    }
  },
  "scripts": {
    "cs": "pint --config vendor/portavice/laravel-pint-config/pint.json --test",
    "csfix": "pint --config vendor/portavice/laravel-pint-config/pint.json",
    "test": "vendor/bin/phpunit"
  }
}
